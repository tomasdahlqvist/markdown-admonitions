{
  "name": "markdown-admonitions",
  "displayName": "Markdown Admonitions",
  "description": "Adds support for Docusaurus style fenced divs to the markdown preview.",
  "version": "1.0.0",
  "publisher": "tomasdahlqvist",
  "license": "MIT",
  "icon": "icon.png",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomasdahlqvist/markdown-admonitions.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "docusaurus",
    "fenced-div",
    "markdown",
    "preview",
    "admonitions"
  ],
  "homepage": "https://github.com/tomasdahlqvist/markdown-admonitions",
  "bugs": {
    "url": "https://github.com/tomasdahlqvist/markdown-admonitions/issues"
  },
  "preview": false,
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.previewStyles": [
      "./styles.css"
    ],
    "configuration": {
      "title": "Markdown Admonitions",
      "properties": {
        "markdownAdmonitions.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable preview of Markdown Admonitions"
        },
        "markdownAdmonitions.mode": {
          "type": "string",
          "default": "relaxed",
          "enum": [
            "relaxed",
            "strict-docusaurus",
            "strict-nextcloud",
            "strict-mkdocs"
          ],
          "enumDescriptions": [
            "Accept Docusaurus and Nextcloud fenced admonitions, plus MkDocs admonitions.",
            "Accept Docusaurus keywords with optional Markdown titles, IDs, and classes.",
            "Accept only Nextcloud keywords and map them to Docusaurus styles.",
            "Accept MkDocs-style admonitions."
          ],
          "description": "Admonition parsing mode. Defaults to relaxed."
        }
      }
    },
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "deploy": "vsce publish",
    "test": "vscode-test"
  },
  "dependencies": {
    "markdown-it-admon-collapsible": "^1.9.5",
    "markdown-it-container": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "markdown-it": "^15.0.3",
    "typescript": "^7.0.2"
  }
}
